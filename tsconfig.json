{
  "compilerOptions": {
    "module": "Node16",
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "sourceMap": true,
    "rootDir": "",
    "strict": true, // enable all strict type-checking options
    "skipLibCheck": true, // upstream d.ts (e.g. @huggingface/transformers) has internal errors
    "forceConsistentCasingInFileNames": true,
    /* Additional Checks */
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedParameters": true,
    "paths": {
      "@common/*": ["./common/*"]
    }
  },
  "include": ["src/**/*.ts", "common/**/*.ts", "test/**/*.ts"]
}
